    uint8_t salir = 0;

    while (!salir) {
        // Obtener la hora actual
        Get_Time();

        lcd_clear();
        sprintf(buffer, "HORA: %02d:%02d:%02d", time.hour, time.minutes, time.seconds);
        lcd_enviar(buffer, 0, 0);
        sprintf(buffer, "FECHA: %02d/%02d/%02d", time.dayofmonth, time.month, time.year);
        lcd_enviar(buffer, 1, 0);

        // Verificar entrada del usuario
        char k = Keypad_Get_Char();
        if (k != 0) {
            HAL_Delay(200);  // Debounce

            if (k == '*') {
                salir = 1;  // Volver al menú principal
            }
            else if (k == '#') {
                // Entrar en modo configuración
                configurar_rtc();
            }
        }

        HAL_Delay(200);  // Actualizar cada 200ms
    }
}



void configurar_hora_riego(void) {
    uint8_t nueva_hora = hora_riego;
    uint8_t nuevo_minuto = minuto_riego;
    uint8_t estado = 0;  // 0: configurando hora, 1: configurando minutos, 2: activar/desactivar
    uint8_t salir = 0;

    while (!salir) {
        lcd_clear();

        if (estado == 0) {
            lcd_enviar("CONF. HORA RIEGO", 0, 0);
            sprintf(buffer, "HORA: %02d  #:SIG", nueva_hora);
            lcd_enviar(buffer, 1, 0);
        }
        else if (estado == 1) {
            lcd_enviar("CONF. MIN RIEGO", 0, 0);
            sprintf(buffer, "MIN: %02d  #:SIG", nuevo_minuto);
            lcd_enviar(buffer, 1, 0);
        }
        else if (estado == 2) {
            lcd_enviar("PROGRAMADOR", 0, 0);
            sprintf(buffer, "%s  #:GUARDAR", riego_programado_activo ? "ACTIVADO" : "DESACTIVADO");
            lcd_enviar(buffer, 1, 0);
        }

        char k = Keypad_Get_Char();

        if (k != 0) {
            HAL_Delay(200);  // Debounce

            if (estado == 0) {  // Configurando hora
                if (k >= '0' && k <= '9') {
                    uint8_t valor = k - '0';
                    if (valor <= 23) {
                        nueva_hora = valor;
                    }
                }
                else if (k == 'A' && nueva_hora < 23) {
                    nueva_hora++;
                }
                else if (k == 'B' && nueva_hora > 0) {
                    nueva_hora--;
                }
                else if (k == '#') {
                    estado = 1;  // Pasar a configurar minutos
                }
                else if (k == '*') {
                    salir = 1;  // Cancelar
                }
            }
            else if (estado == 1) {  // Configurando minutos
                if (k >= '0' && k <= '9') {
                    uint8_t valor = k - '0';
                    if (valor <= 59) {
                        nuevo_minuto = valor;
                    }
                }
                else if (k == 'A' && nuevo_minuto < 59) {
                    nuevo_minuto++;
                }
                else if (k == 'B' && nuevo_minuto > 0) {
                    nuevo_minuto--;
                }
                else if (k == '#') {
                    estado = 2;  // Pasar a activar/desactivar
                }
                else if (k == '*') {
                    estado = 0;  // Volver a configurar hora
                }
            }
            else if (estado == 2) {  // Activando/desactivando
                if (k == 'A' || k == 'B') {
                    riego_programado_activo = !riego_programado_activo;
                }
                else if (k == '#') {
                    // Guardar configuración
                    hora_riego = nueva_hora;
                    minuto_riego = nuevo_minuto;

                    lcd_clear();
                    lcd_enviar("HORA GUARDADA", 0, 0);
                    sprintf(buffer, "%02d:%02d %s", hora_riego, minuto_riego,
                            riego_programado_activo ? "ON" : "OFF");
                    lcd_enviar(buffer, 1, 0);
                    HAL_Delay(1500);

                    salir = 1;
                }
                else if (k == '*') {
                    estado = 1;  // Volver a configurar minutos
                }
            }
        }
    }
}


void modo_automatico(void) {
    lcd_clear();

    // Variable estática para saber si se activó por tiempo programado
    static uint8_t activado_por_tiempo = 0;

    // Si está regando, mostrar información según el origen
    if (bomba_activa) {
        if (activado_por_tiempo) {
            // Mostrar tiempo restante si fue activado por tiempo programado
            uint32_t tiempo_transcurrido = (HAL_GetTick() - tiempo_inicio_riego) / 1000;
            uint32_t tiempo_restante = TIEMPO_RIEGO_PROGRAMADO;

            if (tiempo_transcurrido < TIEMPO_RIEGO_PROGRAMADO) {
                tiempo_restante = TIEMPO_RIEGO_PROGRAMADO - tiempo_transcurrido;
                lcd_enviar("REGANDO:TIEMPO", 0, 0);
                sprintf(buffer, "RESTA: %lu seg", tiempo_restante);
                lcd_enviar(buffer, 1, 0);

                // Si se completó el tiempo, desactivar bomba
                if (tiempo_restante <= 0) {
                    desactivar_bomba();
                    activado_por_tiempo = 0;
                }
            } else {
                desactivar_bomba();
                activado_por_tiempo = 0;
            }
        } else if (humedad_actual < UMBRAL_HUMEDAD_MIN) {
            // Activado por humedad baja
            lcd_enviar("REGANDO:HUMEDAD", 0, 0);
            sprintf(buffer, "HUM:%d%% BAJA", humedad_actual);
            lcd_enviar(buffer, 1, 0);
        }
    } else {
        // Mostrar hora actual en el modo standby
        sprintf(buffer, "AUTO %02d:%02d:%02d", time.hour, time.minutes, time.seconds);
        lcd_enviar(buffer, 0, 0);

        // Mostrar información alternada en segunda línea
        static uint8_t mostrar_info = 0;

        if (mostrar_info == 0) {
            // Mostrar humedad actual y opción de configuración
            sprintf(buffer, "HUM:%d%% C:CFG", humedad_actual);
            lcd_enviar(buffer, 1, 0);
        } else {
            // Mostrar hora programada
            sprintf(buffer, "PROG:%02d:%02d %s", hora_riego, minuto_riego,
                    riego_programado_activo ? "ON" : "OFF");
            lcd_enviar(buffer, 1, 0);
        }

        // Alternar la información mostrada cada 3 segundos
        static uint32_t ultimo_cambio = 0;
        if (HAL_GetTick() - ultimo_cambio >= 3000) {
            mostrar_info = !mostrar_info;
            ultimo_cambio = HAL_GetTick();
        }

        // Lógica de control automático por humedad
        if (humedad_actual < UMBRAL_HUMEDAD_MIN && !bomba_activa) {
            activar_bomba();
            activado_por_tiempo = 0;  // No activado por tiempo
            lcd_clear();
            lcd_enviar("REGANDO:HUMEDAD", 0, 0);
            sprintf(buffer, "HUM:%d%% BAJA", humedad_actual);
            lcd_enviar(buffer, 1, 0);
        }
        else if (humedad_actual >= UMBRAL_HUMEDAD_MAX && bomba_activa && !activado_por_tiempo) {
            desactivar_bomba();
        }

        // Lógica de riego programado
        if (riego_programado_activo && !bomba_activa) {
            // Actualizar la hora actual ya se hace en el bucle principal
            if (time.hour == hora_riego && time.minutes == minuto_riego && time.seconds < 10) {
                // Iniciar riego si es la hora programada
                activar_bomba();
                activado_por_tiempo = 1;  // Marcar como activado por tiempo
                lcd_clear();
                lcd_enviar("REGANDO:TIEMPO", 0, 0);
                sprintf(buffer, "PROG:%02d:%02d %ds", hora_riego, minuto_riego, TIEMPO_RIEGO_PROGRAMADO);
                lcd_enviar(buffer, 1, 0);
            }
        }
    }
}
void modo_manual(void) {
    lcd_clear();
    lcd_enviar("MODO MANUAL", 0, 0);
    sprintf(buffer, "TIEMPO: %lu s", tiempo_max_riego);
    lcd_enviar(buffer, 1, 0);

    if (bomba_activa) {
        uint32_t tiempo_transcurrido = (HAL_GetTick() - tiempo_inicio_riego) / 1000;
        uint32_t tiempo_restante = tiempo_max_riego;

        if (tiempo_transcurrido < tiempo_max_riego) {
            tiempo_restante = tiempo_max_riego - tiempo_transcurrido;
            lcd_clear();
            lcd_enviar("REGANDO", 0, 0);
            sprintf(buffer, "%lu s  C:PARAR", tiempo_restante);
            lcd_enviar(buffer, 1, 0);
        } else {
            desactivar_bomba();
            lcd_clear();
            lcd_enviar("COMPLETO", 0, 0);
            lcd_enviar("* PARA VOLVER", 1, 0);
        }
    } else {
        lcd_clear();
        lcd_enviar("A+ B- #:RIEGO", 0, 0);
        sprintf(buffer, "TIEMPO: %lu s", tiempo_max_riego);
        lcd_enviar(buffer, 1, 0);
    }
}
void configurar_tiempo(void) {
    lcd_clear();
    lcd_enviar("CONFIG. TIEMPO", 0, 0);
    sprintf(buffer, "ACTUAL: %d seg", tiempo_max_riego);
    lcd_enviar(buffer, 1, 0);

    // Instrucciones para usar letras
    lcd_enviar("A:+5 B:+10 C:+30 D:-", 2, 0);
    lcd_enviar("* CANCEL   # GUARDAR", 3, 0);

    uint32_t nuevo_tiempo = tiempo_max_riego;
    int salir = 0;

    while (!salir) {
        char k = Keypad_Get_Char();

        if (k != 0) {
            HAL_Delay(200);  // Debounce

            switch(k) {
                case 'A':
                    nuevo_tiempo += 5;  // Incrementar 5 segundos
                    lcd_clear();
                    lcd_enviar("CONFIG. TIEMPO", 0, 0);
                    sprintf(buffer, "NUEVO: %d seg", nuevo_tiempo);
                    lcd_enviar(buffer, 1, 0);
                    lcd_enviar("A:+5 B:+10 C:+30 D:-", 2, 0);
                    lcd_enviar("* CANCEL   # GUARDAR", 3, 0);
                    break;

                case 'B':
                    nuevo_tiempo += 10;  // Incrementar 10 segundos
                    lcd_clear();
                    lcd_enviar("CONFIG. TIEMPO", 0, 0);
                    sprintf(buffer, "NUEVO: %d seg", nuevo_tiempo);
                    lcd_enviar(buffer, 1, 0);
                    lcd_enviar("A:+5 B:+10 C:+30 D:-", 2, 0);
                    lcd_enviar("* CANCEL   # GUARDAR", 3, 0);
                    break;

                case 'C':
                    nuevo_tiempo += 30;  // Incrementar 30 segundos
                    lcd_clear();
                    lcd_enviar("CONFIG. TIEMPO", 0, 0);
                    sprintf(buffer, "NUEVO: %d seg", nuevo_tiempo);
                    lcd_enviar(buffer, 1, 0);
                    lcd_enviar("A:+5 B:+10 C:+30 D:-", 2, 0);
                    lcd_enviar("* CANCEL   # GUARDAR", 3, 0);
                    break;

                case 'D':
                    if (nuevo_tiempo > 5) {
                        nuevo_tiempo = nuevo_tiempo / 2;  // Reducir a la mitad (más divertido que solo restar)
                    }
                    lcd_clear();
                    lcd_enviar("CONFIG. TIEMPO", 0, 0);
                    sprintf(buffer, "NUEVO: %d seg", nuevo_tiempo);
                    lcd_enviar(buffer, 1, 0);
                    lcd_enviar("A:+5 B:+10 C:+30 D:-", 2, 0);
                    lcd_enviar("* CANCEL   # GUARDAR", 3, 0);
                    break;

                case '#':
                    // Limitar el tiempo máximo a 300 segundos (5 minutos)
                    if (nuevo_tiempo > 300) nuevo_tiempo = 300;
                    if (nuevo_tiempo < 5) nuevo_tiempo = 5;

                    tiempo_max_riego = nuevo_tiempo;

                    // Mostrar animación de guardado
                    lcd_clear();
                    lcd_enviar("GUARDANDO", 0, 0);
                    lcd_enviar("[          ]", 1, 0);

                    for (int i = 1; i <= 10; i++) {
                        sprintf(buffer, "[");
                        for (int j = 0; j < i; j++) {
                            strcat(buffer, "#");
                        }
                        for (int j = i; j < 10; j++) {
                            strcat(buffer, " ");
                        }
                        strcat(buffer, "]");
                        lcd_enviar(buffer, 1, 0);
                        HAL_Delay(100);
                    }

                    lcd_clear();
                    lcd_enviar("TIEMPO CONFIGURADO", 0, 0);
                    sprintf(buffer, "NUEVO: %d seg", tiempo_max_riego);
                    lcd_enviar(buffer, 1, 0);
                    HAL_Delay(1500);

                    salir = 1;
                    break;

                case '*':
                    // Mostrar mensaje de cancelación
                    lcd_clear();
                    lcd_enviar("CONFIGURACION", 0, 0);
                    lcd_enviar("CANCELADA", 1, 0);
                    HAL_Delay(1000);
                    salir = 1;
                    break;
            }
        }
    }
}
void verificar_tiempo_riego(void) {
    if (bomba_activa && menu_state == 2) {  // Solo en modo manual
        uint32_t tiempo_actual = HAL_GetTick();
        uint32_t tiempo_transcurrido = (tiempo_actual - tiempo_inicio_riego) / 1000;

        if (tiempo_transcurrido >= tiempo_max_riego) {
            desactivar_bomba();
            modo_manual();  // Actualizar la pantalla
        }
    }
}

void activar_bomba(void) {
    // Activar bomba
    HAL_GPIO_WritePin(BOMBA_PORT, BOMBA_PIN, GPIO_PIN_SET);
    // Activar LED indicador
    HAL_GPIO_WritePin(led_GPIO_Port, led_Pin, GPIO_PIN_SET);
    bomba_activa = 1;
    tiempo_inicio_riego = HAL_GetTick();  // Registrar tiempo de inicio
}

void desactivar_bomba(void) {
    // Desactivar bomba
    HAL_GPIO_WritePin(BOMBA_PORT, BOMBA_PIN, GPIO_PIN_RESET);
    // Desactivar LED indicador
    HAL_GPIO_WritePin(led_GPIO_Port, led_Pin, GPIO_PIN_RESET);
    bomba_activa = 0;
}

uint8_t leer_humedad(void) {
    // El ADC mide de 0 a 4095 (12 bits)
    // Convertir a porcentaje (0-100%)

    // Valores de calibración
    const uint32_t VALOR_SECO = 3800;    // Valor ADC cuando el suelo está seco
    const uint32_t VALOR_MOJADO = 1800;  // Valor ADC cuando el suelo está húmedo

    // Limitar el valor dentro del rango de calibración
    uint32_t valor_limitado = medida;
    if (valor_limitado > VALOR_SECO) valor_limitado = VALOR_SECO;
    if (valor_limitado < VALOR_MOJADO) valor_limitado = VALOR_MOJADO;

    // Convertir a porcentaje (suponiendo que más voltaje = menos humedad)
    // 100% - (valor - min) * 100 / (max - min)
    uint8_t porcentaje = (uint8_t)(100 - (((valor_limitado - VALOR_MOJADO) * 100) / (VALOR_SECO - VALOR_MOJADO)));

    return porcentaje;
}

void actualizar_estado(void) {
    // Verificar si el riego manual ha excedido el tiempo máximo
    if (bomba_activa && menu_state == 2) {  // En modo manual
        uint32_t tiempo_transcurrido = (HAL_GetTick() - tiempo_inicio_riego) / 1000;
        if (tiempo_transcurrido >= tiempo_max_riego) {
            desactivar_bomba();
        }
    }
}
void configurar_rtc(void) {
    TIME nueva_config;

    // Obtener hora actual como punto de partida
    Get_Time();
    nueva_config = time;

    uint8_t paso = 0;  // 0:hora, 1:min, 2:día, 3:mes, 4:año
    uint8_t salir = 0;

    while (!salir) {
        lcd_clear();

        // Mostrar el parámetro actual que se está configurando
        switch (paso) {
            case 0:  // Configurando hora
                lcd_enviar("CONFIGURAR HORA", 0, 0);
                sprintf(buffer, "HORA: %02d A+ B-", nueva_config.hour);
                lcd_enviar(buffer, 1, 0);
                break;

            case 1:  // Configurando minutos
                lcd_enviar("CONFIGURAR MIN", 0, 0);
                sprintf(buffer, "MIN: %02d  A+ B-", nueva_config.minutes);
                lcd_enviar(buffer, 1, 0);
                break;

            case 2:  // Configurando día
                lcd_enviar("CONFIGURAR DIA", 0, 0);
                sprintf(buffer, "DIA: %02d  A+ B-", nueva_config.dayofmonth);
                lcd_enviar(buffer, 1, 0);
                break;

            case 3:  // Configurando mes
                lcd_enviar("CONFIGURAR MES", 0, 0);
                sprintf(buffer, "MES: %02d  A+ B-", nueva_config.month);
                lcd_enviar(buffer, 1, 0);
                break;

            case 4:  // Configurando año
                lcd_enviar("CONFIGURAR AÑO", 0, 0);
                sprintf(buffer, "AÑO: 20%02d A+ B-", nueva_config.year);
                lcd_enviar(buffer, 1, 0);
                break;
        }

        // Esperar entrada del teclado
        char k = Keypad_Get_Char();

        if (k != 0) {
            HAL_Delay(200);  // Debounce

            switch (k) {
                case 'A':  // Incrementar valor
                    switch (paso) {
                        case 0:  // Hora
                            if (nueva_config.hour < 23) nueva_config.hour++;
                            else nueva_config.hour = 0;  // Circular
                            break;

                        case 1:  // Minutos
                            if (nueva_config.minutes < 59) nueva_config.minutes++;
                            else nueva_config.minutes = 0;  // Circular
                            break;

                        case 2:  // Día
                            if (nueva_config.dayofmonth < 31) nueva_config.dayofmonth++;
                            else nueva_config.dayofmonth = 1;  // Circular
                            break;

                        case 3:  // Mes
                            if (nueva_config.month < 12) nueva_config.month++;
                            else nueva_config.month = 1;  // Circular
                            break;

                        case 4:  // Año
                            if (nueva_config.year < 99) nueva_config.year++;
                            else nueva_config.year = 0;  // Circular
                            break;
                    }
                    break;

                case 'B':  // Decrementar valor
                    switch (paso) {
                        case 0:  // Hora
                            if (nueva_config.hour > 0) nueva_config.hour--;
                            else nueva_config.hour = 23;  // Circular
                            break;

                        case 1:  // Minutos
                            if (nueva_config.minutes > 0) nueva_config.minutes--;
                            else nueva_config.minutes = 59;  // Circular
                            break;

                        case 2:  // Día
                            if (nueva_config.dayofmonth > 1) nueva_config.dayofmonth--;
                            else nueva_config.dayofmonth = 31;  // Circular
                            break;

                        case 3:  // Mes
                            if (nueva_config.month > 1) nueva_config.month--;
                            else nueva_config.month = 12;  // Circular
                            break;

                        case 4:  // Año
                            if (nueva_config.year > 0) nueva_config.year--;
                            else nueva_config.year = 99;  // Circular
                            break;
                    }
                    break;

                case '#':  // Siguiente parámetro
                    paso++;
                    if (paso > 4) {  // Finalizar configuración
                        // Validar fecha (días del mes)
                        if (nueva_config.dayofmonth > 30 && (nueva_config.month == 4 ||
                            nueva_config.month == 6 || nueva_config.month == 9 ||
                            nueva_config.month == 11)) {
                            nueva_config.dayofmonth = 30;
                        } else if (nueva_config.month == 2) {
                            // Febrero
                            if (nueva_config.dayofmonth > 29) {
                                nueva_config.dayofmonth = 29;
                            }

                            // Verificar año bisiesto
                            int anio = 2000 + nueva_config.year;
                            if ((anio % 4 != 0) || (anio % 100 == 0 && anio % 400 != 0)) {
                                // No es bisiesto
                                if (nueva_config.dayofmonth > 28) {
                                    nueva_config.dayofmonth = 28;
                                }
                            }
                        }

                        // Calcular día de la semana (1=Lunes, 7=Domingo)
                        int d = nueva_config.dayofmonth;
                        int m = nueva_config.month;
                        int y = 2000 + nueva_config.year;
                        if (m < 3) {
                            m += 12;
                            y--;
                        }
                        int dow = (d + 2*m + 3*(m+1)/5 + y + y/4 - y/100 + y/400) % 7 + 1;
                        nueva_config.dayofweek = dow;

                        // Guardar en RTC
                        Set_Time(0, nueva_config.minutes, nueva_config.hour,
                                 nueva_config.dayofweek, nueva_config.dayofmonth,
                                 nueva_config.month, nueva_config.year);

                        // Mostrar confirmación
                        lcd_clear();
                        lcd_enviar("FECHA Y HORA", 0, 0);
                        lcd_enviar("CONFIGURADAS", 1, 0);
                        HAL_Delay(1500);

                        salir = 1;
                    }
                    break;

                case '*':  // Cancelar
                    lcd_clear();
                    lcd_enviar("CONFIGURACION", 0, 0);
                    lcd_enviar("CANCELADA", 1, 0);
                    HAL_Delay(1000);
                    salir = 1;
                    break;
            }
        }
    }
}

