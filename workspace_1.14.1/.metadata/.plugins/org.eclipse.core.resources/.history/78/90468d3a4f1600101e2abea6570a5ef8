/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  MX_ADC1_Init();
  /* USER CODE BEGIN 2 */
 HAL_ADC_Start_DMA(&hadc1, &medida, 1);
  // Configurar el pin de la bomba como salida
  GPIO_InitTypeDef GPIO_InitStruct = {0};
  GPIO_InitStruct.Pin = BOMBA_PIN;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(BOMBA_PORT, &GPIO_InitStruct);

  // Asegurarse de que la bomba esté apagada al inicio
  desactivar_bomba();

  // Inicializar LCD
  lcd_init();

  // Mostrar pantalla de bienvenida
  lcd_enviar("SISTEMA DE RIEGO", 0, 0);
  lcd_enviar("INTELIGENTE", 1, 0);
  lcd_enviar("Iniciando...", 2, 0);
  HAL_Delay(2000);

  // Mostrar menú principal
  display_menu();

  // Inicializar la fecha y hora del RTC (ajustar a la fecha y hora actuales)
  // Formato: segundos, minutos, horas, día de la semana (1=Lun, 7=Dom), día del mes, mes, año
//  Set_Time(0, 44, 14, 4, 10, 4, 25);  // 10 de Abril de 2025, 14:30:00, Jueves
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

	  // Obtener la hora actual del RTC
	      Get_Time();

	      // Verificar tiempo de riego (para apagar la bomba si se excede el tiempo)
	      verificar_tiempo_riego();

	      // Actualizar estado del sistema
	      actualizar_estado();

	      // Verificar riego programado (si estamos en modo automático)
	      if (menu_state == 1 && riego_programado_activo && !bomba_activa) {
	          if (time.hour == hora_riego && time.minutes == minuto_riego && time.seconds < 10) {
	              // Iniciar riego si es la hora programada
	              activar_bomba();
	              modo_automatico();  // Actualizar pantalla
	          }
	      }

	      // Leer tecla del keypad
	      char key = Keypad_Get_Char();

	      if (key != 0) {
	          if (menu_state == 0) {  // En el menú principal
	              switch (key) {
	                  case '2':  // Mover cursor hacia abajo
	                      cursor_position = (cursor_position + 1) % 3;
	                      display_menu();
	                      break;

	                  case '8':  // Mover cursor hacia arriba
	                      cursor_position = (cursor_position + 2) % 3;
	                      display_menu();
	                      break;

	                  case '#':  // Seleccionar opción
	                      menu_state = cursor_position + 1;
	                      if (menu_state == 1) {       // Modo Automático
	                          modo_automatico();
	                      } else if (menu_state == 2) { // Modo Manual
	                          modo_manual();
	                      } else if (menu_state == 3) { // Configuración
	                          configurar_tiempo();
	                          menu_state = 0;
	                          display_menu();
	                      }else if (cursor_position == 3) {  // Nueva opción 4 para reloj
	                          mostrar_reloj();
	                          menu_state = 0;
	                          display_menu();
	                      }
	                      break;

	                  case '1':  // Acceso directo a modo automático
	                      menu_state = 1;
	                      modo_automatico();
	                      break;

	                  case '3':  // Acceso directo a modo manual
	                      menu_state = 2;
	                      modo_manual();
	                      break;

	                  case '4':  // Acceso directo a ver el reloj
	                              mostrar_reloj();
	                              menu_state = 0;
	                              display_menu();
	                              break;
	              }
	          }
	          else if (menu_state == 1) {  // En modo automático
	              if (key == '*') {  // Volver al menú principal
	                  menu_state = 0;
	                  display_menu();
	              }
	              else if (key == 'C') {  // Configurar hora de riego
	                  configurar_hora_riego();
	                  modo_automatico();  // Actualizar pantalla
	              }
	          }
	          else if (menu_state == 2) {  // En modo manual
	              if (key == '*') {  // Volver al menú principal
	                  if (bomba_activa) {
	                      desactivar_bomba();  // Apagar bomba al salir
	                  }
	                  menu_state = 0;
	                  display_menu();
	              }
	              else if (key == '#' && !bomba_activa) {
	                  activar_bomba();  // Iniciar riego con el tiempo configurado
	                  modo_manual();    // Actualizar pantalla
	              }
	              else if (key == 'A' && !bomba_activa) {
	                  // Aumentar tiempo de riego de 5 en 5
	                  tiempo_max_riego += 5;
	                  if (tiempo_max_riego > 300) tiempo_max_riego = 300;  // Máximo 5 minutos
	                  modo_manual();    // Actualizar pantalla con el nuevo tiempo
	              }
	              else if (key == 'B' && !bomba_activa) {
	                  // Disminuir tiempo de riego de 5 en 5
	                  if (tiempo_max_riego > 5) {
	                      tiempo_max_riego -= 5;
	                  }
	                  modo_manual();    // Actualizar pantalla con el nuevo tiempo
	              }
	              else if (key == 'C' && bomba_activa) {
	                  // Detener el riego manualmente
	                  desactivar_bomba();
	                  lcd_clear();
	                  lcd_enviar("RIEGO DETENIDO", 0, 0);
	                  HAL_Delay(1000);
	                  modo_manual();    // Actualizar pantalla
	              }
	          }
	          HAL_Delay(200);  // Debounce para evitar múltiples detecciones
	      }

	      // Actualizar pantalla según el modo actual
	      if (menu_state == 1) {  // En modo automático
	          // Actualizar cada segundo
	          static uint32_t last_update = 0;
	          if (HAL_GetTick() - last_update >= 1000) {
	              modo_automatico();
	              last_update = HAL_GetTick();
	          }
	      }
	      else if (menu_state == 2 && bomba_activa) {  // En modo manual con bomba activa
	          // Actualizar cada segundo
	          static uint32_t last_manual_update = 0;
	          if (HAL_GetTick() - last_manual_update >= 1000) {
	              modo_manual();
	              last_manual_update = HAL_GetTick();
	          }
	      }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

